# Use a disposable local PostgreSQL database. Never paste a production URL here.
DATABASE_URL=postgresql://localhost:5432/underground_press_dev

# Set a unique local random value before starting the API.
SESSION_SECRET=

# Optional local identity-provider configuration. Real sign-in is not part of the
# fixture test setup; see README.md before configuring an OIDC provider.
REPL_ID=
ISSUER_URL=https://replit.com/oidc

# Replit Object Storage paths are intentionally not provisioned or copied here.
PUBLIC_OBJECT_SEARCH_PATHS=
PRIVATE_OBJECT_DIR=

# Optional comma-separated account IDs for local role testing only.
MYRTLE_EDITOR_USER_IDS=
NEWSROOM_ADMIN_USER_IDS=

PORT=3000
BASE_PATH=/
API_ORIGIN=http://127.0.0.1:3000
